{
  "name": "cursorforge",
  "private": true,
  "version": "1.20.0",
  "description": "Your pointer. Possessed.",
  "license": "MIT",
  "author": "feylo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "generate:packs": "cargo run --manifest-path src-tauri/Cargo.toml --release --bin genpacks -- assets/packs",
    "generate:icon": "cargo run --manifest-path src-tauri/Cargo.toml --release --bin genpacks -- --icon src-tauri/icons/source.png 1024",
    "generate:icon:dev": "cargo run --manifest-path src-tauri/Cargo.toml --release --bin genpacks -- --icon src-tauri/icons/dev-source.png 1024 --dev && npm run tauri -- icon src-tauri/icons/dev-source.png -o src-tauri/icons/dev",
    "lint:types": "tsc --noEmit",
    "version:set": "node scripts/set-version.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:roles": "cargo run --manifest-path src-tauri/Cargo.toml --release --bin genpacks -- --check-roles",
    "soak": "cargo run --manifest-path src-tauri/Cargo.toml --release --bin genpacks -- --soak",
    "release": "node scripts/build-release.mjs",
    "dev:channel": "npm run tauri -- dev --features dev-channel --config dev.tauri.conf.json",
    "build:dev": "node scripts/build-dev.mjs",
    "channels": "node scripts/channels.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
