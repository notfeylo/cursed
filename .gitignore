node_modules/
dist/
.vite/
*.local

# Rust
src-tauri/target/

# Regenerated by tauri-build from capabilities/ on every build. Committing it
# means every capability change lands twice in the diff, once by hand and once
# by the build.
src-tauri/gen/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini

# Secrets — never commit signing material
*.key
.tauri/

# Release artifacts. Built by `npm run tauri build` and published to GitHub
# Releases — 5 MB of binaries has no business in git history.
dist-release/
dist-photo/
release-notes.md

# Review artefacts from the logo, matte and role tooling — `genpacks
# --logo-sheet`, `--cutout`, `--roles` and friends all write here. They are
# working output, regenerated on demand, and the tracked copies went stale the
# moment the mark changed: a repo full of renders of a logo we no longer use is
# worse than no renders at all.
logo-sheets/

# Soak output: a day of samples per run, regenerated on demand.
docs/verification/soak/*.csv
